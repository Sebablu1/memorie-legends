rules_version = '2';

// ============================================================
// Memorie Legends — reglas de Firestore
//
// Escritas contra las colecciones que EXISTEN hoy (`users`, `rooms`) más
// las que usará el servidor cuando haya Cloud Functions.
//
// Regla de oro: el saldo de Leyendas (`users.credits`) es de SÓLO LECTURA
// para el navegador. Da igual lo que el usuario edite en localStorage o
// escriba en la consola: no puede cambiar su saldo ni el de nadie.
//
// Las Cloud Functions usan credenciales de administrador y NO pasan por
// estas reglas, así que podrán mover saldo cuando se desplieguen.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esDuenio(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Campos que el jugador SÍ puede tocar de su propio perfil.
    // Todo lo demás (saldo, estadísticas, insignias, marcas de tiempo de
    // bonos) queda reservado al servidor.
    // `avatar` SALIÓ de esta lista al crear la tienda de personalización.
    //
    // Ese campo pasó a guardar el avatar EQUIPADO, o sea un id del catálogo que
    // el jugador tiene que haber comprado. Si el navegador pudiera seguir
    // escribiéndolo, equiparse el más caro sin pagarlo serían dos líneas en la
    // consola y la tienda entera sería decorativa.
    //
    // Sacarlo no rompió nada porque nadie lo escribía: el tablero muestra la
    // foto de Google, que viene de Auth y no de este documento. Se comprobó
    // recorriendo todas las escrituras del cliente antes de cerrarlo.
    //
    // `insignia` y `dorso` nunca estuvieron acá, así que ya estaban cerrados.
    function soloCamposPropios() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['username', 'photoURL']);
    }

    // Saldo de bienvenida permitido al crear la cuenta. Cualquier otro
    // valor se rechaza, para que nadie se cree el perfil con un millón.
    function saldoDeBienvenidaValido() {
      return request.resource.data.credits == 100;
    }

    // ---------------------------------------------------- perfiles
    match /users/{uid} {
      /**
       * El perfil lo lee SU DUEÑO y nadie más.
       *
       * Antes decía `allow read: if autenticado()`, con el argumento de que
       * "el lobby y el ranking muestran nombres" y de que acá no había datos
       * sensibles. Las dos mitades eran falsas:
       *
       *   - En este documento vive `credits`, o sea el saldo. Cualquier
       *     jugador logueado podía leer cuánto tiene cada uno de los demás,
       *     además de sus partidas y sus victorias.
       *   - Y ni el lobby ni el ranking lo necesitaban. La sala guarda los
       *     nombres en `jugadoresNombres` dentro de su propio documento, y las
       *     filas del ranking guardan su `uid` y sus estadísticas. Ninguna de
       *     las dos pantallas lee `users` de nadie: se comprobó recorriendo
       *     todas las lecturas del cliente antes de cerrar esto.
       *
       * Por eso alcanza con restringir la lectura y no hace falta mover
       * `credits` a una subcolección: mover el campo obligaba a migrar los
       * datos de todas las cuentas y a tocar cada lectura y cada escritura del
       * saldo, para llegar al mismo lugar. Menos partes móviles, menos formas
       * de equivocarse con el dinero de la gente.
       *
       * Las Cloud Functions no pasan por estas reglas: usan credenciales de
       * administrador, así que el panel y el ranking siguen funcionando.
       */
      allow read: if esDuenio(uid);

      // La cuenta se crea una sola vez, y sólo con el saldo de bienvenida.
      allow create: if esDuenio(uid) && saldoDeBienvenidaValido();

      // El jugador sólo puede cambiar su nombre o su avatar.
      // `credits`, `wins` y `gamesPlayed` quedan fuera de su alcance.
      allow update: if esDuenio(uid) && soloCamposPropios();

      allow delete: if false;

      /**
       * Subcolecciones del perfil: sólo lectura propia.
       *
       * Acá cae `users/{uid}/items`, que es donde se anota qué artículos de la
       * tienda compró cada jugador. No hizo falta una regla nueva —esta ya
       * decía lo correcto: su dueño lee, nadie escribe— y por eso se deja como
       * está en vez de agregar un `match` que diga lo mismo dos veces.
       *
       * Que el cliente no pueda escribir es justamente lo que hace que la
       * posesión signifique algo: la crea `comprarItem` después de cobrar.
       */
      match /{documento=**} {
        allow read: if esDuenio(uid);
        allow write: if false;
      }
    }

    // ------------------------------------------------------- salas
    // Las salas las escribe ÚNICAMENTE el servidor: crear, unirse, iniciar
    // y salir pasan por Cloud Functions, que usan credenciales de admin y
    // no pasan por estas reglas. El cliente sólo mira.
    //
    // Antes el navegador escribía acá directamente, y eso permitía cambiar
    // el estado de la sala, sumarse sin pagar o iniciar la partida ajena.
    match /rooms/{salaId} {
      allow read: if autenticado();
      allow write: if false;
    }

    // ------------------------------------- colecciones del servidor
    // Todas de sólo lectura para el cliente. Las escribe únicamente el
    // servidor con credenciales de administrador.

    // Libro mayor: cada quien ve sus propios movimientos.
    match /movimientos/{id} {
      allow read: if autenticado() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Órdenes de compra: sólo las propias.
    match /ordenes/{id} {
      allow read: if autenticado() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ------------------------------------------------ catálogo de la tienda
    //
    // Los avatares, insignias y dorsos que están a la venta. Se lee desde el
    // navegador para poder pintar la tienda sin una Cloud Function de por
    // medio; se escribe SÓLO desde el servidor, porque acá viven los precios.
    //
    // Que el precio sea legible no es un problema: el que cobra es el que lee
    // este mismo documento dentro de la transacción. Lo que no puede pasar es
    // que se pueda ESCRIBIR, y eso es lo que cierra la segunda línea.
    match /catalogo/{itemId} {
      allow read: if autenticado();
      allow write: if false;
    }

    // Rankings: públicos para leer, imposibles de escribir.
    match /rankings/{periodo} {
      allow read: if true;
      allow write: if false;

      match /jugadores/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Partidas cerradas y su resultado.
    // ------------------------------------------------- partidas en red
    //
    // El documento de una partida contiene el estado COMPLETO del motor: las
    // manos de los cuatro jugadores y el mazo con su orden. Si un jugador
    // pudiera leerlo, el juego se termina: abre la consola y ve todo.
    //
    // Por eso NADIE lo lee. Cada jugador lee sólo su propia vista recortada,
    // que el servidor escribe con `vistaDe` en la misma transacción.
    match /partidas/{id} {
      allow read: if false;
      allow write: if false;

      // Lo que ese jugador puede saber, y sólo él.
      match /vistas/{uid} {
        allow read: if esDuenio(uid);
        allow write: if false;
      }

      // Cualquier otra subcolección que aparezca queda negada por omisión.
      match /{resto=**} {
        allow read, write: if false;
      }
    }

    // Torneos: los lee cualquiera, los administra sólo el servidor.
    match /torneos/{id} {
      allow read: if autenticado();
      allow write: if false;

      match /{documento=**} {
        allow read: if autenticado();
        allow write: if false;
      }
    }

    // Todo lo no contemplado queda cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
